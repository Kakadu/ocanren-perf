; --- run all benchmarks -------------------------------------------------------

(rule
 (alias go-bench)
 (deps
  test001_expo1.exe
  test002_logo1.exe
  test005_thrines.exe
  test006_twines.exe
  test007_quines.exe)
 (action
  (run sh -c "./test001_expo1.exe && ./test002_logo1.exe && ./test005_thrines.exe && ./test006_twines.exe && ./test007_quines.exe")))
