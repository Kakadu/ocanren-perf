(library
 (name counters)
 (modules counters))

(library
 (name numero_decls_trace)
 (libraries OCanren OCanren.tester counters)
 (modules numero_decls_trace)
 (wrapped false)
 (preprocessor_deps %{project_root}/unif_count/pp5+dump.exe ./pp5+dump.exe)
 (preprocess
  (pps
   OCanren-ppx.ppx_fresh
   OCanren-ppx.ppx_repr
   GT.ppx_all
   --
   -pp
   "unif_count/pp5+dump.exe -D TRACE")))

