(executable
 (name numero)
 (modules numero)
 (libraries numero_decls_trace)
 (preprocess
  (pps OCanren-ppx.ppx_repr)))

(executable
 (name run_scheme)
 (modules run_scheme)
 (libraries Quine_decls_trace Quines_NoDiseq_trace)
 (preprocess
  (pps OCanren-ppx.ppx_repr)))

(cram
 (deps ./numero.exe ./run_scheme.exe))

(rule
 (targets pp5+dump.exe)
 (action
  (run
   mkcamlp5.opt
   -package
   camlp5,camlp5.pa_o,camlp5.macro,camlp5.pr_dump
   -o
   %{targets})))
