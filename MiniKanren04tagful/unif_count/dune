(library
 (name Quines_NoDiseq_trace)
 (libraries OCanren OCanren.tester counters Quine_decls PrintHelpers)
 (modules Quines_NoDiseq_trace)
 (wrapped false)
 (preprocessor_deps %{project_root}/unif_count/pp5+dump.exe ./pp5+dump.exe)
